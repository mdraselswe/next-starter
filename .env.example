# Copy to .env.local for local overrides. Every variable is validated in src/config/env.ts.
# NEXT_PUBLIC_* values are built into the browser bundle: never put secrets in them.

# Production URL override (default: `url` in src/config/site.ts)
NEXT_PUBLIC_SITE_URL=

# Build mode override: static | server (default: `render` in src/config/site.ts; prefer `pnpm mode`)
RENDER_MODE=
